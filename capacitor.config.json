{
  "appId": "com.formora.app",
  "appName": "Formora",
  "webDir": "www",
  "backgroundColor": "#0e0f13",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0e0f13"
  },
  "android": {
    "backgroundColor": "#0e0f13"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0e0f13",
      "showSpinner": false
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  }
}
